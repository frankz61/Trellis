# Existing external services (fill real hosts; do NOT commit real secrets)
NEO4J_URI=bolt://<neo4j-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
DATABASE_URL=postgresql://<user>:<pwd>@<pg-host>:5432/trellis
# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
# Speech-to-text (STT_API_KEY may be empty to reuse LLM_API_KEY)
STT_BASE_URL=https://<openai-compatible-host>/v1
STT_API_KEY=
STT_MODEL=groq/whisper-large-v3-turbo
AUDIO_MAX_MB=10
# Text-to-speech (TTS_API_KEY may be empty to reuse STT_API_KEY / LLM_API_KEY)
TTS_BASE_URL=https://<openai-compatible-host>/v1
TTS_API_KEY=
TTS_MODEL=deepgram/aura-asteria-en
TTS_VOICE=asteria
TTS_RESPONSE_FORMAT=mp3
TTS_MAX_INPUT_CHARS=2000
# Backend
BACKEND_PORT=57702
FRONTEND_PORT=57701
CORS_ORIGINS=["http://localhost:57701","http://127.0.0.1:57701"]
